# Copy to .env.local for local dev. On Cloudflare, set these in the dashboard
# (Workers / Pages → Settings → Variables and Secrets). Never commit real values.

# Canonical public URL, no trailing slash (metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# WhatsApp link shown after form submit (still visible in the browser when users tap through).
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/60123456789

# Optional: Google Business / Maps URL (site links).
# NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Optional: next intake date for UI (YYYY-MM-DD).
# NEXT_PUBLIC_NEXT_INTAKE_DATE=

# Server-only: webhook for POST /api/lead (Make.com, Zapier, etc.). Mark as encrypted secret in Cloudflare.
MAKE_WEBHOOK_URL=

# Server-only: Ed25519 private JWK (JSON one line) for /.well-known/http-message-signatures-directory (Web Bot Auth).
# Generate with: openssl genpkey -algorithm ed25519 -out key.pem && node -e "const fs=require('fs');const c=require('crypto');const k=c.createPrivateKey(fs.readFileSync('key.pem'));console.log(JSON.stringify(k.export({format:'jwk'})))"
# In production, never use the RFC 9421 test key — register your directory URL with your bot program (e.g. Cloudflare).
# WEB_BOT_AUTH_ED25519_JWK=

# Local Wrangler / OpenNext preview only — see https://developers.cloudflare.com/workers/testing/local-development/
# NEXTJS_ENV=development
