# Environment variables — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cloudflare Worker local secrets (wrangler dev / OpenNext)
.dev.vars

# Node modules
node_modules/
package-lock.json

# Next.js build output
.next/
.open-next/
out/

# Production build
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-specific files
.DS_Store
Thumbs.db

# Local deploy CLI link metadata (ignore if present)
.vercel/

# Optional: if using TypeScript
*.tsbuildinfo

# Optional: if using testing tools
coverage/
jest-test-results.json

# Optional: if using IDEs
.vscode/
.idea/

# Local Cursor/Claude IDE settings (personal overrides, not for shared VCS)
.claude/

# Optional: if using TurboRepo or monorepo
turbo/
# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
